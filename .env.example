# === Kopiere diese Datei zu ".env" und trage deine echten Keys ein ===
# .env wird NIE eingecheckt (siehe .gitignore) — enthält Secrets.

# Claude API — für Script- & Trend-Generierung (~1-2€/Monat)
# Holen unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Pexels API — kostenloses Stock-Footage (Natur/Lifestyle-Clips für Hintergrund)
# Holen unter: https://www.pexels.com/api/ (kostenlos, sofort, kein Warten)
PEXELS_API_KEY=

# TikTok Account — KEIN Passwort hier eintragen!
# Beim ersten Lauf öffnet sich ein Browserfenster, dort loggst du dich manuell ein.
# Danach werden Cookies gespeichert und alles läuft automatisch.
TIKTOK_ACCOUNT_NAME=mindset_daily_de

# Posting-Konfiguration
POSTS_PER_DAY=1
POST_TIME=18:30
TIMEZONE=Europe/Berlin

# ── TTS-Backend ────────────────────────────────────────────────────────────────
# "edge"   → KOSTENLOS, kein Key, natürlichste Stimme [DEFAULT]
# "piper"  → KOSTENLOS, native deutsche Stimme (Thorsten-Voice), läuft lokal, Offline-Fallback
# "kokoro" → KOSTENLOS, lokal, aber englischer Akzent bei Deutsch
# "fish"   → KOSTENPFLICHTIG (~15€/1M Zeichen), beste Qualität
TTS_BACKEND=edge
# --- ECHTE Erzaehlerstimme (empfohlen, KOSTENLOS, keine Kreditkarte) ---
# 1) Konto auf https://elevenlabs.io anlegen (Free-Tier: 10.000 Zeichen/Monat = ca. 12-15 Kurzvideos)
# 2) Profil -> API Keys -> Key erzeugen, hier eintragen. Sobald gesetzt, wird sie automatisch genutzt.
ELEVENLABS_API_KEY=
# Stimmen (premade, im Free-Tier nutzbar): Brian nPczCjzI2devNBz1zQrb (dunkler Trailer-Erzaehler, Default),
# Daniel onwK4e9ZLuTAKqWW03F9, George JBFqnCBsd6RMkjVDRZzb, Adam pNInz6obpgDQGcFmaJgB
ELEVEN_VOICE_ID=g1jpii0iyvtRs8fqXsd1
# Eigene/hinzugefuegte Stimme per Name (muss unter "Stimmen -> Meine Stimmen" liegen), z.B. Leonard:
ELEVEN_VOICE_NAME=
# Modell: eleven_v4 (neuestes, ausdrucksstaerkstes; Standard). Alternative: eleven_multilingual_v2 (stabil)
ELEVEN_MODEL=eleven_v4

# Stimm-Charakter (wirkt auf jedes Backend via ffmpeg-Nachbearbeitung):
# "grimdark" → tief, rau, narbig, episch - "jemand der selbst gelitten hat"  [DEFAULT]
# "jarvis"   → tiefer, ruhig, warm, sauber (der alte Sound)
# "off"      → keine Nachbearbeitung
VOICE_FX=grimdark
# 1.0 = KEIN zusätzlicher Pitch-Shift (Edge-TTS liefert die Tonhöhe schon fertig
# via EDGE_PITCH/EDGE_RATE unten; ein zweiter Shift hier gab die Verzerrung/
# "Ton schlecht"-Artefakte aus dem ersten Versuch). Nur ändern, wer weiß was er tut.
VOICE_PITCH=1.0

# Fish Audio (nur wenn TTS_BACKEND=fish)
FISH_API_KEY=
FISH_VOICE_ID=

# Optional: Proxy für den Upload-Browser (empfohlen bei mehreren Accounts)
# Format: server:port:username:password  (leer lassen wenn nicht genutzt)
PROXY=

# ── KI fuer Skripte & Recherche ─────────────────────────────────────────────────
# "gemini"  → KOSTENLOS, KEINE Kreditkarte. Key: https://aistudio.google.com/apikey  [EMPFOHLEN]
# "claude"  → Anthropic (Guthaben noetig), "offline" → nur Vorrat, kein Key
AI_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Bild-Stil ────────────────────────────────────────────────────────────────
# "street_bw"        → raue Schwarz-Weiß-Optik (Beton, hoher Kontrast, Körnung) [DEFAULT]
#                       wie Street-Art-Zitat-Poster: weißer Impact-Font, kein Farbakzent
# "cinematic_color"  → der ursprüngliche, farbige, dunkel abgetönte Cinematic-Look
VISUAL_STYLE=street_bw

# ── Musik-Stil ───────────────────────────────────────────────────────────────
# "epic_dark" → tiefe Moll-Akkorde, ferne Kriegstrommeln, Trailer-Riser - episch/dunkel [DEFAULT]
# "soft_pad"  → der ursprüngliche, ruhige Piano-Pad-Sound
# Alles 100% selbst synthetisiert (kein Sample, kein Download) -> garantiert lizenzfrei.
# Eigene freie Tracks kannst du zusätzlich in assets/music/ ablegen (werden dann bevorzugt).
MUSIC_STYLE=epic_dark
MUSIC_GAIN_DB=-16

# Cover-Stil: "hand" = Slogan wie mit Edding auf eine Handfläche geschrieben (braucht PIXABAY_API_KEY,
# GEMINI_API_KEY hilft beim Platzieren), "poster" = prozedurales Poster. Fehler -> automatisch Poster.
COVER_STYLE=hand

# --- Reserve-KI, KOSTENLOS ohne Kreditkarte (springt automatisch ein, wenn Gemini ausgelastet/gesperrt ist) ---
# Key: https://console.groq.com/keys  (Konto mit Google-Login, "Create API Key")
GROQ_API_KEY=

# --- KI-Szenen (Film-Look): zu jedem Textabschnitt wird eine passende Szene erzeugt, Kamera faehrt darueber ---
AI_SCENES=1            # 0 = aus (dann Stock-Footage von Pixabay)
SCENE_LOOK=cinema      # cinema = Kinofilm-Look | streetart = Wandbild/Stencil-Look
# Optional, kostenlos (schneller, ohne Wasserzeichen): Konto auf auth.pollinations.ai, Token hier eintragen
POLLINATIONS_TOKEN=

# KI-Cutter: Gemini prueft Vorschaubilder vor jedem Clip (1=an, 0=aus)
VISION_CHECK=1

# ══════════════════════════════════════════════════════════════════════════════
#  MEHRERE ACCOUNTS (Portfolio) — siehe STRATEGIE_10K.md
#  Welche Accounts es gibt, steht in content/accounts.json (keine Secrets dort!).
#  Hier stehen nur die Zugangsdaten.
# ══════════════════════════════════════════════════════════════════════════════

# ── Instagram (offizielle Graph API — Reels + Karussells) ─────────────────────
# Voraussetzung: IG-Konto auf "Business" umgestellt UND mit einer Facebook-Seite verbunden.
# Meta-App (developers.facebook.com) mit Produkt "Instagram Graph API", Rechte:
#   instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
# Danach im Graph API Explorer ein LANGLEBIGES Seiten-Token erzeugen (60 Tage,
# verlängert sich bei Nutzung automatisch) und hier eintragen:
IG_ACCESS_TOKEN=
# Die IG-Business-User-ID je Account (NICHT der @name — die lange Zahl).
# Findest du im Graph API Explorer: GET /me/accounts -> instagram_business_account.id
IG_USER_ID_MINDSET=
IG_USER_ID_KI=
IG_USER_ID_NEBEN=

# ── Medien-Host (NUR für Instagram nötig) ─────────────────────────────────────
# Instagram lädt keine Dateien hoch, es holt sie von einer öffentlichen URL ab.
# "local" = Ordner public/ auf deinem VPS, den du per nginx/Caddy ausliefert
# "s3"    = Cloudflare R2 / Hetzner / AWS (braucht: pip install boto3)
# "off"   = Instagram-Upload deaktiviert
MEDIA_HOST=off
MEDIA_BASE_URL=            # z.B. https://cdn.deine-domain.de
MEDIA_PUBLIC_DIR=          # leer = ./public
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── YouTube Shorts (offizielle Data API v3) ───────────────────────────────────
# Google-Cloud-Projekt -> "YouTube Data API v3" aktivieren -> OAuth-Client (Typ: TV/Gerät)
# Refresh-Token je Kanal erzeugen mit:  python3 uploader_youtube.py --auth
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN_MINDSET=
